
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ImportPilot AI | WhatsApp Negotiator</title>
<style>
:root{--bg:#10101a;--panel:#191927;--field:#12121e;--border:#302f45;--text:#f5f3ff;--muted:#a5a2bb;--purple:#9675ff;--green:#44d6a0;--red:#ff7c8b}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:14px/1.6 Inter,system-ui,Arial,sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.app{display:grid;grid-template-columns:225px minmax(0,1fr);min-height:100vh}
aside{background:#151520;border-right:1px solid var(--border);padding:25px 16px}
.brand{display:flex;align-items:center;gap:10px;margin-bottom:35px}
.logo{background:linear-gradient(135deg,#b49aff,#7751ed);width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-weight:900;font-size:18px}
.brand strong{display:block;font-size:15px}.brand small{color:var(--muted);font-size:10px}
.navlabel{color:#77758e;font-size:10px;letter-spacing:1.4px;margin:20px 8px 8px}
.nav{padding:11px;border-radius:9px;color:var(--muted);margin:4px 0}
.nav.active{background:#302645;color:#ded2ff}
.aside-note{border:1px solid var(--border);padding:12px;border-radius:10px;margin-top:45px;color:var(--muted);font-size:11px}
main{padding:28px;max-width:1500px;width:100%;margin:auto;min-width:0}
.header{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:24px}
.eyebrow{color:var(--purple);font-size:11px;letter-spacing:1.6px;font-weight:750}
h1{font-size:29px;letter-spacing:-.8px;margin:4px 0}
.sub,.muted{color:var(--muted)}
.sub{margin:0;font-size:13px}
.status{white-space:nowrap;border:1px solid var(--border);border-radius:30px;padding:7px 11px;color:var(--muted);font-size:11px}
.dot{display:inline-block;background:var(--green);width:7px;height:7px;border-radius:50%;margin-right:7px}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin-bottom:20px}
.stat,.card{background:var(--panel);border:1px solid var(--border);border-radius:13px}
.stat{padding:15px}.stat label{color:var(--muted);font-size:11px}
.stat strong{display:block;font-size:21px;margin:6px 0}
.stat small{color:var(--muted);font-size:11px}
.layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(275px,.85fr);gap:18px;align-items:start}
.card{padding:20px;margin-bottom:18px}
.cardhead{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:18px}
h2{font-size:15px;margin:0}.desc{font-size:11px;color:var(--muted);margin-top:3px}
.tag{font-size:10px;color:#d3c6ff;background:#302645;padding:5px 8px;border-radius:6px}
.field{margin-bottom:15px}
label{display:block;font-size:12px;font-weight:650;margin-bottom:6px;color:#e4e0f4}
input,select,textarea{width:100%;background:var(--field);border:1px solid #39374f;color:var(--text);padding:10px 11px;border-radius:8px;outline:none;min-width:0}
input:focus,select:focus,textarea:focus{border-color:var(--purple);box-shadow:0 0 0 2px #9675ff20}
textarea{resize:vertical;min-height:130px}
.hint{font-size:10px;color:var(--muted);margin-top:5px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.phone{display:grid;grid-template-columns:105px 1fr;gap:8px}
.secret{position:relative}.secret input{padding-right:55px}
.show{position:absolute;right:7px;top:50%;transform:translateY(-50%);background:none;border:0;color:#bca8ff;font-size:10px}
.rowcheck{display:flex;align-items:center;gap:9px;margin:8px 0 16px;color:var(--muted);font-size:12px}
.rowcheck input{width:auto;accent-color:var(--purple)}
.btn{border:1px solid var(--border);border-radius:8px;padding:10px 13px;background:#252438;color:var(--text);font-weight:650}
.primary{background:linear-gradient(110deg,#a185ff,#7752e9);border:0;flex:1;color:white}
.btn:disabled{opacity:.5;cursor:not-allowed}
.actions{display:flex;gap:9px;flex-wrap:wrap}
.spinner{display:inline-block;width:13px;height:13px;border:2px solid #ffffff55;border-top-color:white;border-radius:50%;animation:spin .7s linear infinite;vertical-align:-2px;margin-right:7px}
@keyframes spin{to{transform:rotate(360deg)}}
.preview{min-height:125px;border:1px solid #29483e;background:#111b19;padding:13px;border-radius:9px;white-space:pre-wrap;overflow-wrap:anywhere;color:#d9f7e9}
.preview.empty{border-color:var(--border);background:#14141f;color:#7f7b94}
.previewbar{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-top:10px}
.small{font-size:10px;color:var(--muted)}
.loglist{display:flex;flex-direction:column;gap:12px;max-height:330px;overflow:auto}
.log{display:flex;gap:9px;font-size:11px;overflow-wrap:anywhere}
.logicon{width:23px;height:23px;flex-shrink:0;display:grid;place-items:center;background:#302645;border-radius:7px}
.logbody strong{display:block;font-weight:650}
.logbody small{color:var(--muted)}
.log.success strong{color:var(--green)}.log.error strong{color:var(--red)}
.warning{font-size:10px;color:#e6c78a;margin-top:12px}
footer{text-align:center;color:#716d83;font-size:10px;padding:12px}
@media(max-width:950px){.app{grid-template-columns:1fr}aside{display:none}.layout{grid-template-columns:1fr}}
@media(max-width:540px){main{padding:15px 11px}.header{align-items:flex-start}.stats{gap:7px}.stat{padding:10px}.stat strong{font-size:17px}h1{font-size:24px}.card{padding:14px}.grid2{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
<aside>
  <div class="brand"><div class="logo">IP</div><div><strong>ImportPilot AI</strong><small>SUPPLIER NEGOTIATOR</small></div></div>
  <div class="navlabel">WORKSPACE</div>
  <div class="nav active">◈ &nbsp; Negotiation Dashboard</div>
  <div class="nav">✉ &nbsp; Message Preview</div>
  <div class="nav">⌘ &nbsp; Activity Logs</div>
  <div class="navlabel">INTEGRATIONS</div>
  <div class="nav">✳ &nbsp; Groq AI</div>
  <div class="nav">◉ &nbsp; WhatsApp Cloud API</div>
  <div class="aside-note"><strong>Security notice</strong><br>Credentials are held in page memory, not saved to local storage. Avoid public computers.</div>
</aside>

<main>
  <header class="header">
    <div><div class="eyebrow">AI-POWERED PROCUREMENT</div><h1>Negotiation Dashboard</h1><p class="sub">Your AI assistant for international paper sourcing.</p></div>
    <div class="status"><span class="dot"></span> Ready to configure</div>
  </header>

  <section class="stats">
    <div class="stat"><label>AI ENGINE</label><strong>Groq</strong><small>Language model API</small></div>
    <div class="stat"><label>MESSAGE CHANNEL</label><strong>WhatsApp</strong><small>Meta Cloud API</small></div>
    <div class="stat"><label>ACCEPTED THIS SESSION</label><strong id="sentCount">0</strong><small>Accepted by Meta API</small></div>
  </section>

  <div class="layout">
    <section class="card">
      <div class="cardhead"><div><h2>01. API Configuration</h2><div class="desc">Connect your AI and messaging accounts.</div></div><span class="tag">SETUP</span></div>

      <form id="form">
        <div class="field"><label for="groqKey">Groq API Key</label><div class="secret"><input id="groqKey" type="password" autocomplete="off" placeholder="gsk_..." required><button class="show" type="button" data-for="groqKey">Show</button></div></div>
        <div class="field"><label for="waToken">WhatsApp Access Token</label><div class="secret"><input id="waToken" type="password" autocomplete="off" placeholder="Meta access token" required><button class="show" type="button" data-for="waToken">Show</button></div></div>
        <div class="grid2">
          <div class="field"><label for="phoneId">WhatsApp Phone Number ID</label><input id="phoneId" placeholder="Meta phone number ID" required></div>
          <div class="field"><label for="apiVersion">Graph API version</label><select id="apiVersion"><option value="v23.0">v23.0</option><option value="v22.0">v22.0</option><option value="v21.0">v21.0</option></select></div>
        </div>
        <div class="field"><label for="supplier">Recipient WhatsApp Number</label><div class="phone"><select id="country"><option value="86" selected>China +86</option><option value="91">India +91</option><option value="1">USA +1</option><option value="44">UK +44</option><option value="852">Hong Kong +852</option><option value="65">Singapore +65</option><option value="971">UAE +971</option></select><input id="supplier" inputmode="tel" placeholder="Mobile number" required></div><div class="hint">Enter national number only, without the country code.</div></div>

        <div class="field"><label for="model">Groq Model</label><select id="model">
          <option value="llama-3.3-70b-versatile" selected>Llama 3.3 70B Versatile</option>
          <option value="llama-3.1-8b-instant">Llama 3.1 8B Instant</option>
          <option value="openai/gpt-oss-120b">GPT OSS 120B</option>
          <option value="openai/gpt-oss-20b">GPT OSS 20B</option>
        </select><div class="hint">Use a model enabled for your Groq account.</div></div>

        <div class="field"><label for="prompt">System Prompt / AI Rules</label><textarea id="prompt" required>You are an International Paper Import Expert and Master Negotiator. My business is in India, importing Plotter Paper, Tracing Paper, and Printing Paper. Your job is to chat with Chinese suppliers on WhatsApp. Start with 'Hi/Hello' and negotiate to get the lowest rate. Always ask for FOB or CIF rates, and request legal export documents like Proforma Invoice (PI), Packing List, and Certificate of Origin (CO). Also, demand free samples to check GSM and paper quality. Be highly professional, polite, and friendly.

Write a concise, natural first-contact WhatsApp message in English. Ask for GSM, sizes, MOQ, pricing, and sample availability. Request FOB and CIF quotes, confirming the destination port with the buyer. Do not invent quantities, prices, ports, or business details. Do not make payment or order commitments.</textarea></div>

        <div class="field"><label for="instruction">Message Instruction</label><textarea id="instruction" rows="3" required>Generate the first introductory and negotiation message for this supplier.</textarea></div>
        <label class="rowcheck"><input id="testMode" type="checkbox"> Test Mode — generate only the exact text “Hi”</label>
        <div class="actions"><button class="btn" type="button" id="reset">Reset</button><button class="btn primary" id="start" type="submit">✦ Generate &amp; Send Message</button></div>
        <div class="hint">The generated text is shown for confirmation before sending.</div>
      </form>
    </section>

    <div>
      <section class="card">
        <div class="cardhead"><div><h2>02. Message Preview</h2><div class="desc">Review the generated text.</div></div><span class="tag">PREVIEW</span></div>
        <div id="preview" class="preview empty">Your AI-generated message will appear here.</div>
        <div class="previewbar"><span id="meta" class="small">Waiting for generation</span><button class="btn" id="copy" type="button">Copy text</button></div>
        <div class="warning">Verify the recipient and message before approving an external send.</div>
      </section>
      <section class="card">
        <div class="cardhead"><div><h2>03. Activity Log</h2><div class="desc">API progress and diagnostic messages.</div></div><button class="btn" id="clear" type="button">Clear</button></div>
        <div class="loglist" id="logs" aria-live="polite"></div>
      </section>
    </div>
  </div>
  <footer>ImportPilot AI · Verify supplier details and commercial terms before placing an order.</footer>
</main>
</div>

<script>
"use strict";
const $ = id => document.getElementById(id);
let busy = false, draft = "", accepted = 0;

function log(title, type="info", detail="") {
  const item=document.createElement("div");
  item.className="log "+type;
  const icon=document.createElement("div");
  icon.className="logicon";
  icon.textContent=type==="success"?"✓":type==="error"?"!":"i";
  const body=document.createElement("div");
  body.className="logbody";
  const strong=document.createElement("strong");
  strong.textContent=title;
  const small=document.createElement("small");
  small.textContent=new Date().toLocaleTimeString()+(detail?" · "+detail:"");
  body.append(strong,small);item.append(icon,body);$("logs").prepend(item);
}
function busyState(value){
  busy=value;$("start").disabled=value;$("reset").disabled=value;
  $("start").innerHTML=value?'<span class="spinner"></span>Processing...':"✦ Generate &amp; Send Message";
}
async function responseData(response){
  const raw=await response.text();let data;
  try{data=JSON.parse(raw)}catch{data={message:raw}}
  if(!response.ok){
    const e=data?.error;
    throw new Error((e?.message||data?.message||"API request failed")+
      " (HTTP "+response.status+")");
  }
  return data;
}
function recipientNumber(){
  const raw=$("supplier").value.trim();
  if(!/^[0-9\s().-]+$/.test(raw))throw new Error("Enter the recipient number using digits only.");
  const digits=raw.replace(/\D/g,""),code=$("country").value;
  if(digits.length<5||digits.length>14)throw new Error("Check the recipient number length.");
  if(digits.startsWith(code)&&digits.length>code.length+5)
    throw new Error("The number may already include its country code. Enter the national number only.");
  return code+digits;
}
async function generate(){
  const model=$("model").value;
  const messages=[
    {role:"system",content:$("prompt").value.trim()},
    {role:"user",content:$("testMode").checked
      ?"Output exactly these two characters, with no punctuation or other text: Hi"
      :$("instruction").value.trim()}
  ];
  log("Calling Groq AI","info",model);
  const response=await fetch("https://api.groq.com/openai/v1/chat/completions",{
    method:"POST",
    headers:{"Authorization":"Bearer "+$("groqKey").value.trim(),"Content-Type":"application/json"},
    body:JSON.stringify({model,messages,temperature:0.4,max_tokens:600})
  });
  const data=await responseData(response);
  const text=data?.choices?.[0]?.message?.content?.trim();
  if(!text)throw new Error("Groq returned an empty message.");
  draft=text;$("preview").textContent=text;$("preview").classList.remove("empty");
  $("meta").textContent="Generated · "+model;
  log("AI draft generated","success",text.length+" characters");
  return text;
}
async function sendMessage(text,to){
  const url="https://graph.facebook.com/"+$("apiVersion").value+"/"+encodeURIComponent($("phoneId").value.trim())+"/messages";
  log("Calling Meta WhatsApp API","info","Recipient ending "+to.slice(-4));
  const response=await fetch(url,{
    method:"POST",
    headers:{"Authorization":"Bearer "+$("waToken").value.trim(),"Content-Type":"application/json"},
    body:JSON.stringify({
      messaging_product:"whatsapp",recipient_type:"individual",to,
      type:"text",text:{preview_url:false,body:text}
    })
  });
  const data=await responseData(response);
  const id=data?.messages?.[0]?.id;
  if(!id)throw new Error("No WhatsApp message ID returned. Check Meta API response.");
  accepted++;$("sentCount").textContent=accepted;
  log("Meta accepted the message","success","Message ID: "+id);
  log("Delivery not yet confirmed","info","Check WhatsApp webhooks for delivery status.");
}
$("form").addEventListener("submit",async e=>{
  e.preventDefault();if(busy)return;
  let to;
  try{to=recipientNumber()}catch(err){log("Recipient validation failed","error",err.message);alert(err.message);return}
  const required=["groqKey","waToken","phoneId","prompt","instruction"];
  for(const id of required)if(!$(id).value.trim()){
    log("Missing required field","error",id);$(id).focus();return;
  }
  busyState(true);log("Workflow started");
  try{
    const message=await generate();
    if(!confirm("Send this generated message to +"+to+"?\n\n"+message)){
      log("Sending cancelled","info","Draft remains in preview");return;
    }
    await sendMessage(message,to);
    log("Workflow completed","success","Meta accepted the request");
  }catch(err){
    console.error(err);log("Workflow failed","error",err.message||"Unknown error");
  }finally{busyState(false)}
});
document.querySelectorAll(".show").forEach(b=>b.addEventListener("click",()=>{
  const input=$(b.dataset.for);input.type=input.type==="password"?"text":"password";
  b.textContent=input.type==="password"?"Show":"Hide";
}));
$("copy").addEventListener("click",async()=>{
  if(!draft){log("Nothing to copy","info","Generate a message first");return}
  try{await navigator.clipboard.writeText(draft);log("Copied message","success")}
  catch{log("Clipboard unavailable","error","Select the preview text and copy it manually")}
});
$("clear").addEventListener("click",()=>$("logs").replaceChildren());
$("reset").addEventListener("click",()=>{
  if(!confirm("Clear all form fields and the message preview?"))return;
  $("form").reset();draft="";
  $("preview").textContent="Your AI-generated message will appear here.";
  $("preview").classList.add("empty");$("meta").textContent="Waiting for generation";
  log("Form reset","info","Credentials cleared from the form");
});
log("Dashboard ready","success","Credentials have not been submitted");
</script>
</body>
</html>
